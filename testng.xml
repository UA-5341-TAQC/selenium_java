<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Suite" verbose="1" parallel="tests" thread-count="3">

    <parameter name="cucumber.features.fail-on-undefined-steps" value="false"/>
    <parameter name="allure.results.suite.name" value="Cucumber BDD Tests"/>

    <test name="API Tests" parallel="classes" thread-count="2">
        <classes>
            <class name="org.academy.api.AuthTests"/>
            <class name="org.academy.api.CompanyProfileTests"/>
            <class name="org.academy.api.HistoryTests"/>
            <class name="org.academy.api.MainPageTests"/>
        </classes>
    </test>

    <test name="UI Tests" parallel="classes" thread-count="2">
        <classes>
            <class name="org.academy.ui.admin.TestAdminFaqPage"/>
            <class name="org.academy.ui.HeadSectionTest"/>
            <class name="org.academy.ui.TestAdminPage"/>
            <class name="org.academy.ui.TestContactFormEmailValidation"/>
            <class name="org.academy.ui.TestContactUsPage"/>
            <class name="org.academy.ui.TestFooter"/>
            <class name="org.academy.ui.TestFooterAfterScrollAndReload"/>
            <class name="org.academy.ui.TestFooterBrokenLinks"/>
            <class name="org.academy.ui.TestFooterContent"/>
            <class name="org.academy.ui.TestHistoryPageAdmin"/>
            <class name="org.academy.ui.TestMainPage"/>
            <class name="org.academy.ui.TestPartnersPage"/>
            <class name="org.academy.ui.TestProgramsPage"/>
            <class name="org.academy.ui.TestReportsExpensesChart"/>
            <class name="org.academy.ui.TestReportsPage"/>
            <class name="org.academy.ui.TestReportsTotalCollectedFunds"/>
            <class name="org.academy.ui.TestTeamPage"/>
            <class name="org.academy.ui.TestTeamPageAdmin"/>
            <class name="org.academy.ui.TestWhoWeAreAdminPage"/>
        </classes>
    </test>

    <test name="Cucumber BDD Tests" parallel="data-providers" thread-count="2">
        <classes>
            <class name="org.academy.cucumber.RunCucumberTest"/>
        </classes>
    </test>
</suite>